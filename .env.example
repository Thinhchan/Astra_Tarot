# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO DISCORD TAROT BOT
# ==========================================

# Token xác thực bot Discord (Lấy tại https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# API Key cho Google Gemini AI (Lấy tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# (Tùy chọn) Guild ID dùng để test Slash Command tức thì (Không cần chờ Global sync ~1 giờ)
# TEST_GUILD_ID=123456789012345678

# Model Gemini mặc định (Ví dụ: gemini-1.5-flash hoặc gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash
